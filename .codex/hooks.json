{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|^apply_patch$|^exec_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/guard_raw_data.py\"",
            "timeout": 5,
            "statusMessage": "Protecting existing raw files"
          }
        ]
      }
    ]
  }
}
